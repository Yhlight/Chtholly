format = 1
suite = "chtholly"

[[test]]
name = "chtholly_framework_smoke"
kind = "inprocess"
labels = ["framework"]
registry = "framework_smoke"
timeout_seconds = 10
serial = true

[[test]]
name = "chtholly_artifact_cache_report"
kind = "process"
labels = ["compiler", "artifact", "cache", "recovery"]
command = ["@PYTHON@", "@SOURCE_DIR@/tests/artifact_cache_report_tests.py", "--script", "@SOURCE_DIR@/scripts/report-artifact-cache.py"]
working_directory = "@BUILD_DIR@/tests"
timeout_seconds = 60
serial = true

[[test]]
name = "chtholly_test_runner_tests"
kind = "process"
labels = ["framework", "runner", "hardening"]
command = ["@PYTHON@", "@SOURCE_DIR@/tests/test_runner_tests.py", "--runner", "@TARGET_TEST_RUNNER@"]
working_directory = "@SOURCE_DIR@"
timeout_seconds = 60
serial = true

[[test]]
name = "chtholly_project_workflow_tests"
