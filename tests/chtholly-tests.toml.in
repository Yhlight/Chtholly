labels = ["compiler", "cli", "project", "workspace"]
command = ["@PYTHON@", "@SOURCE_DIR@/tests/chtholly_project_workflow_tests.py", "--chthollyc", "@TARGET_CHTHOLLYC@"]
working_directory = "@BUILD_DIR@/tests"
timeout_seconds = 180
serial = true

