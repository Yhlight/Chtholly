module main;

import std::env;
import std::fs;
import std::io;
import std::option;
import std::result;
import std::text;

fn main(): i32 {
  if (std::env::arg_count() < 3usize) {
    return 10;
  }
  let argument = std::env::arg(1usize);
  if (std::text::is_empty(argument)) {
    return 11;
  }
  if (std::io::write_stdout("safe-io\n") != 8i64) {
    return 12;
  }
  let safe_stdout = std::io::write_stdout_result("safe-result\n");
  let safe_stdout_status = switch (safe_stdout) {
    std::result::Result<usize, i32>::Ok { value = copy .0 } => {
      if (value != 12usize) { return 23; } 0
    };
    std::result::Result<usize, i32>::Err { .. } => 24;
  };
  if (safe_stdout_status != 0) {
    return safe_stdout_status;
  }
  if (std::io::write_stdout(argument) != 16i64) {
    return 13;
  }
  if (std::io::write_stdout("\n") != 1i64) {
    return 14;
  }
  let path = std::env::arg(2usize);
  if (std::fs::exists(path)) {
    return 15;
  }
  let safe_write = std::fs::write_result(path, "safe-file");
  let safe_write_status = switch (safe_write) {
    std::result::Result<usize, i32>::Ok { value = copy .0 } => {
      if (value != 9usize) { return 20; } 0
    };
    std::result::Result<usize, i32>::Err { .. } => 21;
  };
  if (safe_write_status != 0) {
    return safe_write_status;
  }
  if (std::fs::write(path, "safe-file") != 9i64) {
    return 16;
  }
  if (!std::fs::exists(path)) {
    return 17;
  }
  let safe_remove = std::fs::remove_result(path);
  let safe_remove_status = switch (safe_remove) {
    std::result::Result<i32, i32>::Ok { .. } => 0;
    std::result::Result<i32, i32>::Err { .. } => 22;
  };
  if (safe_remove_status != 0) {
    return 18 + safe_remove_status;
  }
  if (std::fs::exists(path)) {
    return 19;
  }
  return 0;
}
