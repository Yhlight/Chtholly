module main;

import std::option;
import std::vec;

fn main(): i32 {
  var values = std::vec::Vec<i32>::init();
  values.reserve(2usize);
  values.push(11);
  values.push(22);
  values.push(33);
  if (values.len() != 3usize) { return 1; }
  if (values.capacity() < 3usize) { return 2; }
  if (values.at(0usize) != 11) { return 3; }
  if (values.at(1usize) != 22) { return 4; }

  let removed = values.remove(1usize);
  if (removed.is_none()) { return 5; }
  if ((move removed).unwrap() != 22) { return 6; }
  if (values.at(1usize) != 33) { return 7; }

  let popped = values.pop();
  if (!popped.is_some()) { return 8; }
  if ((move popped).unwrap() != 33) { return 9; }
  let last = values.pop();
  if ((move last).unwrap() != 11) { return 10; }
  let empty = values.pop();
  if (!empty.is_none()) { return 11; }

  values.push(44);
  values.clear();
  if (values.len() != 0usize) { return 12; }
  return 0;
}
