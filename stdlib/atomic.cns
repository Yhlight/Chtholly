module std::atomic;

pub enum Ordering {
  Relaxed,
  Acquire,
  Release,
  AcqRel,
  SeqCst,
}

pub struct CompareExchange<T> {
  pub observed: T;
  pub exchanged: bool;
}

lifecycle(copy = delete, move = default, drop = default)
pub struct Atomic<T> {
  value: T;
}

impl<T> Atomic<T> {
  pub fn init(value: T): Atomic<T>;
  pub fn load(self: const Atomic<T>&, order: Ordering): T;
  pub fn store(self: const Atomic<T>&, value: T, order: Ordering): void;
  pub fn exchange(self: const Atomic<T>&, value: T, order: Ordering): T;
  pub fn compare_exchange(
      self: const Atomic<T>&, expected: T, desired: T,
      success: Ordering, failure: Ordering): CompareExchange<T>;
  pub fn fetch_add(self: const Atomic<T>&, value: T, order: Ordering): T;
  pub fn fetch_sub(self: const Atomic<T>&, value: T, order: Ordering): T;
  pub fn fetch_and(self: const Atomic<T>&, value: T, order: Ordering): T;
  pub fn fetch_or(self: const Atomic<T>&, value: T, order: Ordering): T;
  pub fn fetch_xor(self: const Atomic<T>&, value: T, order: Ordering): T;
}
